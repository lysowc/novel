APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_novel
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=
DB_STRICT=true
DB_POOL_MAX_CONNECTIONS=5
DB_POOL_MIN_CONNECTIONS=1
DB_POOL_WAIT_TIMEOUT=3
DB_POOL_IDLE_TIMEOUT=60
DB_POOL_HEARTBEAT_INTERVAL=50

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_POOL_MAX_CONNECTIONS=5
REDIS_POOL_MIN_CONNECTIONS=1

SESSION_LIFETIME=604800
SESSION_SECURE=false
SESSION_SAME_SITE=lax

# AI Provider credentials remain in the database. These tune all compatible calls.
AI_HTTP_TIMEOUT=120
AI_TEMPERATURE=0.8
NOVEL_CONTEXT_MAX_RECENT_CHAPTERS=5
NOVEL_CONTEXT_SUMMARY_CHARACTERS=12000
